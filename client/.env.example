VITE_API_BASE_URL=/api
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
# In Google Cloud, add https://uvgobicol.tech as an Authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# PayPal checkout loads its public Sandbox client ID from the authenticated server.
# Configure PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET on the server; never put the secret here.
