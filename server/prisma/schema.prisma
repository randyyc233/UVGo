generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DISPATCHER
  DRIVER
  PASSENGER
}

enum AuthChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum RouteCode {
  GOA
  LEGAZPI
}

enum DispatchProtocol {
  GOSO
  TAYA
}

enum GeofenceEventType {
  ENTERED
  EXITED
}

enum VehicleStatus {
  OFFLINE
  OUTSIDE_ZONE
  INCOMING
  AT_TERMINAL
  WAITING
  LOADING
  READY_FOR_DISPATCH
  DEPARTURE_PENDING
  DEPARTURE_REVIEW
  ON_TRIP
  DELAYED
  UNAVAILABLE
}

enum QueueStatus {
  WAITING
  ASSIGNED
  ACCEPTED
  REJECTED
  READY_FOR_DISPATCH
  DEPARTED
  DELAYED
  REPLACED
}

enum TripStatus {
  SCHEDULED
  ASSIGNING
  ASSIGNED
  BOARDING
  READY
  DEPARTED
  COMPLETED
  DELAYED
  UNABLE_TO_DEPART
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ReservationStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  RESCHEDULED
  REALLOCATED
  FORFEITED
}

enum PaymentMethod {
  PAYPAL
  GCASH_RECEIPT
  LEGACY
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  VERIFIED
  CAPTURED
  REJECTED
  FAILED
}

enum NotificationType {
  ASSIGNMENT
  PAYMENT
  BOOKING
  REALLOCATION
  QUEUE
  TRIP
  SYSTEM
}

enum DispatchAction {
  GEOFENCE_ENTERED
  GEOFENCE_EXITED
  TERMINAL_ARRIVAL_CONFIRMED
  DEPARTURE_AUTHORIZED
  DEPARTURE_REVIEW_REQUIRED
  ASSIGNMENT_CREATED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_REJECTED
  ASSIGNMENT_CANCELLED
  QUEUE_OVERRIDDEN
  MOVED_TO_LAST
  VEHICLE_REPLACED
  DRIVER_NOTIFIED
  TRIP_STARTED
  TRIP_DEPARTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  RESERVATION_REALLOCATED
  DRIVER_CREATED
  DRIVER_UPDATED
  DRIVER_DEACTIVATED
  VEHICLE_UPDATED
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_DELETED
  DEMO_SIMULATION
}

model User {
  id                    String                @id @default(cuid())
  role                  UserRole
  dispatcherRoute       RouteCode?
  name                  String                @db.VarChar(120)
  contact               String?               @db.VarChar(32)
  email                 String                @unique @db.VarChar(191)
  googleSubject         String?               @unique @db.VarChar(191)
  passwordHash          String                @db.VarChar(191)
  emailVerifiedAt       DateTime?
  tokenVersion          Int                   @default(0)
  isActive              Boolean               @default(true)
  managedByDispatcherId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  assignedVehicle       Vehicle?              @relation("VehicleDriver")
  reservations          Reservation[]         @relation("PassengerReservations")
  verifiedPayments      Payment[]             @relation("PaymentVerifier")
  passengerCounts       PassengerCount[]      @relation("PassengerCountSubmitter")
  notifications         Notification[]
  dispatcherAlertReads  DispatcherAlertRead[]
  dispatchLogs          DispatchLog[]         @relation("DispatchActor")
  tripAssignments       TripAssignment[]      @relation("AssignmentDriver")
  managedByDispatcher   User?                 @relation("DispatcherManagedDrivers", fields: [managedByDispatcherId], references: [id], onDelete: SetNull)
  managedDrivers        User[]                @relation("DispatcherManagedDrivers")
  managedVehicles       Vehicle[]             @relation("DispatcherManagedVehicles")
  createdTrips          Trip[]                @relation("DispatcherCreatedTrips")
  weeklySchedules       WeeklySchedule[]      @relation("DispatcherWeeklySchedules")
  tayaWeeklySchedules   TayaWeeklySchedule[]  @relation("DispatcherTayaWeeklySchedules")
  tayaDailySchedules    TayaDailySchedule[]   @relation("DispatcherTayaDailySchedules")
  authChallenges        AuthChallenge[]

  @@index([role, dispatcherRoute, isActive])
  @@index([managedByDispatcherId, role, isActive])
}

model AuthChallenge {
  id         String               @id @default(cuid())
  userId     String
  purpose    AuthChallengePurpose
  codeHash   String               @db.Char(64)
  expiresAt  DateTime
  attempts   Int                  @default(0)
  consumedAt DateTime?
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt, consumedAt])
}

model Vehicle {
  id                        String               @id @default(cuid())
  vanId                     String               @unique @db.VarChar(32)
  plateNo                   String               @unique @db.VarChar(32)
  route                     RouteCode
  protocol                  DispatchProtocol
  capacity                  Int                  @default(11)
  status                    VehicleStatus        @default(OUTSIDE_ZONE)
  assignedDriverId          String?              @unique
  managedByDispatcherId     String?
  lastKnownInsideZone       Boolean              @default(false)
  insideTerminalZone        Boolean              @default(false)
  locationTrackingActive    Boolean              @default(false)
  goOnTripEnabled           Boolean              @default(false)
  latestArrivalAt           DateTime?
  latestLatitude            Decimal?             @db.Decimal(10, 7)
  latestLongitude           Decimal?             @db.Decimal(10, 7)
  latestLocationAccuracyM   Decimal?             @db.Decimal(8, 2)
  latestLocationObservedAt  DateTime?
  latestDistanceKm          Decimal?             @db.Decimal(7, 3)
  terminalEntrySampleCount  Int                  @default(0)
  terminalExitSampleCount   Int                  @default(0)
  departureSequenceStartKm  Decimal?             @db.Decimal(7, 3)
  departureAuthorizedAt     DateTime?
  departureAuthorizedTripId String?              @db.VarChar(191)
  departureReviewRequired   Boolean              @default(false)
  departureReviewReason     String?              @db.VarChar(500)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  assignedDriver            User?                @relation("VehicleDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  managedByDispatcher       User?                @relation("DispatcherManagedVehicles", fields: [managedByDispatcherId], references: [id], onDelete: SetNull)
  geofenceEvents            GeofenceEvent[]
  queueEntries              QueueEntry[]
  trips                     Trip[]
  passengerCounts           PassengerCount[]
  weeklySchedules           WeeklySchedule[]
  tayaWeeklySchedules       TayaWeeklySchedule[]
  tayaDailySchedules        TayaDailySchedule[]

  @@index([route, status])
  @@index([managedByDispatcherId, route])
  @@index([lastKnownInsideZone, status])
  @@index([departureReviewRequired, departureAuthorizedAt])
}

model GeofenceEvent {
  id             String            @id @default(cuid())
  vehicleId      String
  eventType      GeofenceEventType
  timestamp      DateTime          @default(now())
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  distanceKm     Decimal?          @db.Decimal(7, 3)
  accuracyMeters Decimal?          @db.Decimal(8, 2)
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp])
  @@index([eventType, timestamp])
}

model QueueEntry {
  id                   String             @id @default(cuid())
  vehicleId            String
  route                RouteCode
  /// Null means an assigned Taya van has not been admitted to the active queue.
  position             Int?
  arrivalTimestamp     DateTime
  /// Confirmed terminal arrival for the current Taya queue admission. Null
  /// means the assigned driver is not currently admitted to the terminal queue.
  tayaArrivalAt        DateTime?
  /// GOSO queue priority. Scheduled drivers sort by this value, regardless of
  /// terminal arrival time, until their own loading deadline is missed.
  scheduledLoadingTime DateTime?
  /// Set once a scheduled Goa driver is outside the terminal geofence when
  /// their loading time is reached. Late rows stay behind all on-time rows.
  lateAt               DateTime?
  status               QueueStatus        @default(WAITING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  vehicle              Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignments          TripAssignment[]
  tayaDailySchedule    TayaDailySchedule?

  @@index([route, status, position])
  @@index([route, lateAt, scheduledLoadingTime])
  @@index([route, arrivalTimestamp])
  @@index([vehicleId, status])
}

model Trip {
  id                        String             @id @default(cuid())
  vehicleId                 String
  route                     RouteCode
  scheduledOrTriggeredTime  DateTime
  /// When passengers may begin boarding. Dispatcher-set for Goso schedules;
  /// derived as departure - boarding window for queue/geofence-created trips.
  boardingStartTime         DateTime?
  loadingConfirmedAt        DateTime?
  loadingConfirmedVehicleId String?
  awaitingQueueReplacement  Boolean            @default(false)
  status                    TripStatus         @default(SCHEDULED)
  fareAmount                Decimal            @db.Decimal(10, 2)
  createdByDispatcherId     String?
  weeklyScheduleId          String?
  weeklyOccurrenceDate      DateTime?
  departedAt                DateTime?
  completedAt               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  vehicle                   Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdByDispatcher       User?              @relation("DispatcherCreatedTrips", fields: [createdByDispatcherId], references: [id], onDelete: SetNull)
  weeklySchedule            WeeklySchedule?    @relation(fields: [weeklyScheduleId], references: [id], onDelete: SetNull)
  reservations              Reservation[]
  reservedSeats             ReservationSeat[]
  passengerCounts           PassengerCount[]
  assignments               TripAssignment[]
  tayaDailySchedule         TayaDailySchedule?

  @@unique([weeklyScheduleId, weeklyOccurrenceDate])
  @@index([route, scheduledOrTriggeredTime])
  @@index([createdByDispatcherId, scheduledOrTriggeredTime])
  @@index([vehicleId, status])
}

/// A permanent Monday-Sunday Goa timetable slot. Concrete Trip rows are
/// generated ahead on a rolling horizon so passengers can book them normally.
model WeeklySchedule {
  id              String   @id @default(cuid())
  dispatcherId    String
  vehicleId       String
  /// ISO weekday: Monday = 1, Sunday = 7.
  weekday         Int
  /// Minutes after midnight in Asia/Manila.
  boardingMinute  Int
  departureMinute Int
  fareAmount      Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dispatcher      User     @relation("DispatcherWeeklySchedules", fields: [dispatcherId], references: [id], onDelete: Restrict)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trips           Trip[]

  @@index([dispatcherId, vehicleId, weekday])
  @@index([dispatcherId, isActive, weekday])
  @@index([vehicleId, isActive])
}

/// A recurring Legazpi/Taya driver assignment for an ISO weekday. Its saved
/// order does not determine the arrival-based operational queue.
model TayaWeeklySchedule {
  id           String   @id @default(cuid())
  dispatcherId String
  vehicleId    String
  /// ISO weekday: Monday = 1, Sunday = 7.
  weekday      Int
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  dispatcher   User     @relation("DispatcherTayaWeeklySchedules", fields: [dispatcherId], references: [id], onDelete: Restrict)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([weekday, vehicleId])
  @@unique([weekday, position])
  @@index([dispatcherId, weekday])
  @@index([vehicleId, weekday])
}

/// A dispatcher-defined Legazpi/Taya driver assignment for one Manila service
/// day. QueueEntry owns the operational arrival-based queue position.
model TayaDailySchedule {
  id           String      @id @default(cuid())
  dispatcherId String
  vehicleId    String
  serviceDate  DateTime    @db.Date
  position     Int
  queueEntryId String?     @unique
  tripId       String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dispatcher   User        @relation("DispatcherTayaDailySchedules", fields: [dispatcherId], references: [id], onDelete: Restrict)
  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  trip         Trip?       @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@unique([serviceDate, vehicleId])
  @@unique([serviceDate, position])
  @@index([dispatcherId, serviceDate])
  @@index([vehicleId, serviceDate])
}

model TripAssignment {
  id               String           @id @default(cuid())
  tripId           String
  queueEntryId     String?
  driverId         String
  status           AssignmentStatus @default(PENDING)
  assignedAt       DateTime         @default(now())
  responseDeadline DateTime
  respondedAt      DateTime?
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  queueEntry       QueueEntry?      @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  driver           User             @relation("AssignmentDriver", fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([tripId, queueEntryId])
  @@index([driverId, status])
  @@index([status, responseDeadline])
}

/// Displayed route-card fare; individual trips retain their scheduled fare.
model PublicRouteFare {
  route      RouteCode @id
  fareAmount Decimal   @db.Decimal(10, 2)
  updatedAt  DateTime  @updatedAt
}

model Reservation {
  id                    String            @id @default(cuid())
  reference             String            @unique @db.VarChar(32)
  passengerId           String
  tripId                String
  seatCount             Int
  fareAmount            Decimal           @db.Decimal(10, 2)
  studentPassengers     Int               @default(0)
  seniorPassengers      Int               @default(0)
  discountAmount        Decimal           @default(0) @db.Decimal(10, 2)
  /// Successful passenger reschedules; automatic dispatcher reallocations do not count.
  rescheduleCount       Int               @default(0)
  status                ReservationStatus @default(PENDING_PAYMENT)
  originalReservationId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  passenger             User              @relation("PassengerReservations", fields: [passengerId], references: [id], onDelete: Restrict)
  trip                  Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  originalReservation   Reservation?      @relation("ReservationLineage", fields: [originalReservationId], references: [id], onDelete: SetNull)
  derivedReservations   Reservation[]     @relation("ReservationLineage")
  seats                 ReservationSeat[]
  payments              Payment[]

  @@index([passengerId, createdAt])
  @@index([tripId, status])
  @@index([originalReservationId])
}

model ReservationSeat {
  id            String      @id @default(cuid())
  reservationId String
  tripId        String
  seatNumber    Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@index([reservationId])
}

model Payment {
  id                   String        @id @default(cuid())
  reservationId        String
  method               PaymentMethod
  paypalOrderId        String?       @unique @db.VarChar(191)
  gcashReference       String?       @db.VarChar(100)
  /// Normalized method + external transaction reference. Null when the
  /// passenger supplies no optional GCash reference.
  externalReferenceKey String?       @unique @db.VarChar(191)
  receiptImageKey      String?       @db.VarChar(191)
  receiptMimeType      String?       @db.VarChar(64)
  amount               Decimal       @db.Decimal(10, 2)
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  verifiedByUserId     String?
  verifiedAt           DateTime?
  rejectionReason      String?       @db.VarChar(500)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  reservation          Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  verifiedBy           User?         @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([method, status, createdAt])
  @@index([reservationId])
  @@index([verifiedByUserId])
}

model PassengerCount {
  id                  String   @id @default(cuid())
  vehicleId           String
  tripId              String
  count               Int
  submittedByDriverId String
  timestamp           DateTime @default(now())
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip                Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  submittedBy         User     @relation("PassengerCountSubmitter", fields: [submittedByDriverId], references: [id], onDelete: Restrict)

  @@index([tripId, timestamp])
  @@index([vehicleId, timestamp])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String           @db.VarChar(500)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model DispatcherAlertRead {
  id          String    @id @default(cuid())
  userId      String
  alertKey    String    @db.VarChar(191)
  readAt      DateTime  @default(now())
  dismissedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertKey])
  @@index([userId, readAt])
}

model DispatchLog {
  id          String         @id @default(cuid())
  actorUserId String
  action      DispatchAction
  targetId    String         @db.VarChar(191)
  route       RouteCode?
  reason      String?        @db.VarChar(500)
  metadata    Json?
  timestamp   DateTime       @default(now())
  actor       User           @relation("DispatchActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, timestamp])
  @@index([route, timestamp])
  @@index([action, timestamp])
  @@index([targetId])
}
