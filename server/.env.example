NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="mysql://uvgo:uvgo_dev_password@localhost:3306/uvgo"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Gmail SMTP delivery. Enable 2-Step Verification, then create a 16-character
# Google App Password at https://myaccount.google.com/apppasswords.
# Never use the account's normal password. Keep both values blank to use the
# development-only console code instead of sending email.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=UVGo NCEBT
EMAIL_CODE_TTL_MINUTES=10
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayMongo QR Ph. Start with matching sk_test_/pk_test_ keys. Register
# https://your-domain.example/api/webhooks/paymongo for payment.paid,
# payment.failed, and qrph.expired, then place that endpoint's whsk_ secret here.
# Never expose PAYMONGO_SECRET_KEY or PAYMONGO_WEBHOOK_SECRET to the browser.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_QR_EXPIRY_SECONDS=1800
UPLOAD_DIR=uploads/receipts
DEMO_MODE=true
DISPATCH_ENGINE_INTERVAL_MS=10000
# Shared circle for arrival, loading attendance and automatic queue-head exit.
TERMINAL_ARRIVAL_RADIUS_M=100
GEOFENCE_REQUIRED_SAMPLES=1
GEOFENCE_MAX_ACCURACY_M=50
GEOFENCE_SAMPLE_MIN_INTERVAL_MS=8000
GEOFENCE_SAMPLE_MAX_AGE_MS=60000
GEOFENCE_MIN_OUTWARD_PROGRESS_M=5
